* text=auto eol=lf

# Go source
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# YAML / CI / configs
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts may stay CRLF if you use them
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Third-party reference fixtures are stored exactly as published.
#
# `* text=auto eol=lf` above would normalise SGP4-VER.TLE's CRLF endings, which
# silently changes the bytes and invalidates the SHA-256 its README publishes.
# A verification fixture the VCS rewrites is not the fixture that was verified.
ephemeris/satellite/testdata/vallado/SGP4-VER.TLE -text
ephemeris/satellite/testdata/vallado/tcppver.out  -text
